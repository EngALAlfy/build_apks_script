DISCORD_WEBHOOK=
SLACK_ENABLED=false
SLACK_WEBHOOK=
EMAIL_ENABLED=false
EMAILS=
SMTP_HOST=
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
