# Workspaces and source
GIT_WORKSPACE=D:/FlutterProjects
RESULT_WORKSPACE=D:/APKArtifacts
GIT_USER=
GIT_BRANCH=main
PROJECTS_REPOS=hurryApp
BUILD_TYPES=release
CLEAN_BUILD=true

# Optional MEGA delivery
